---
import '../styles/global.css';

const basePath = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const assetPath = (filename: string) => `${basePath}${filename}`;
const ogImageUrl = new URL(assetPath('og-battery-luxury.png'), 'https://nexum-energy.github.io').toString();
const contactEndpoint = import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT ?? '';
const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL ?? '';
const batteryViews = [
  assetPath('battery-esa3-right.png'),
  assetPath('battery-esa3-front.png'),
  assetPath('battery-esa3-10k.png'),
];

const fundingFlow = [
  ['01', 'AFM', 'Programul de finanțare'],
  ['02', 'Până la 15.000 lei', 'Fonduri nerambursabile'],
  ['03', 'Baterie de stocare', 'Achiziție și montaj'],
  ['04', 'Economie', 'Mai multă energie folosită acasă'],
];

const eligibilityQuestions = [
  { name: 'prosumator', title: 'Ești persoană fizică, prosumator, iar contractul este pe numele tău?', options: [['yes', 'Da'], ['no', 'Nu'], ['unknown', 'Nu sunt sigur']] },
  { name: 'debts', title: 'Ești fără restanțe la bugetul de stat și la bugetul local?', options: [['yes', 'Da'], ['no', 'Nu'], ['unknown', 'Nu știu încă']] },
  { name: 'grid', title: 'Locuința este în România, iar sistemul fotovoltaic este racordat la rețea?', options: [['yes', 'Da'], ['no', 'Nu'], ['unknown', 'Nu sunt sigur']] },
  { name: 'existingStorage', title: 'Ai deja o baterie de stocare instalată la această adresă?', options: [['no', 'Nu'], ['yes', 'Da'], ['unknown', 'Nu sunt sigur']] },
  { name: 'activities', title: 'Se desfășoară activități economice sau profesionale la această adresă?', options: [['none', 'Nu'], ['separate', 'Da, cu contor separat'], ['unseparated', 'Da, fără contor separat']] },
];

const documents = [
  ['Cererea de finanțare', 'Descărcată din aplicația AFM, tehnoredactată și încărcată fără semnătură.'],
  ['Actul de identitate', 'Valabil la data înscrierii în aplicație.'],
  ['Certificat fiscal de stat', 'Emis pe numele solicitantului și în termen de valabilitate.'],
  ['Certificat fiscal local', 'Pentru localitatea de domiciliu.'],
  ['Certificat fiscal pentru implementare', 'Doar dacă adresa proiectului diferă de domiciliu.'],
  ['Contractul de prosumator', 'Pe numele solicitantului și aferent locului de consum.'],
  ['Certificatul de racordare', 'Pentru același loc de consum și producere.'],
  ['Factura de energie', 'Pe numele solicitantului, cu o vechime de cel mult 3 luni.'],
];

const faqs = [
  ['Cât pot obține prin program?', 'Poți solicita până la 15.000 lei finanțare nerambursabilă, fără a depăși 75% din valoarea eligibilă a proiectului. Diferența reprezintă contribuția proprie.'],
  ['Pot aplica dacă am deja o baterie instalată?', 'Nu, conform art. 15 alin. (2), solicitantul nu este eligibil dacă are deja un sistem de stocare instalat la locul de implementare declarat.'],
  ['Este obligatoriu un invertor hibrid?', 'Da. Dacă sistemul fotovoltaic nu are deja un invertor hibrid compatibil, proiectul poate include achiziția și instalarea lui până la punerea în funcțiune a sistemului de stocare.'],
  ['Ce capacitate minimă trebuie să aibă bateria?', 'Minimum 12 kWh. Tehnologia trebuie să fie fără plumb, garanția de minimum 5 ani, iar numărul de cicluri de minimum 3.000.'],
  ['Verificarea Nexum Energy garantează finanțarea?', 'Nu. Analizăm preliminar răspunsurile tale și cerințele din ghid, apoi revenim cu recomandarea noastră. Eligibilitatea și selecția finală sunt stabilite de AFM după verificarea documentelor.'],
];
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Casa Verde — Baterii 2026. Prin programul AFM poți obține până la 15.000 lei fonduri nerambursabile pentru o baterie de stocare." />
    <meta name="theme-color" content="#153f31" />
    <meta property="og:title" content="Casa Verde — Baterii 2026 | Nexum Energy" />
    <meta property="og:description" content="AFM → până la 15.000 lei nerambursabili → baterie de stocare → economie. Verifică dacă te încadrezi." />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content="Nexum Energy — finanțare pentru baterii de stocare" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href={assetPath('nexum-energy-logo.png')} />
    <title>Casa Verde — Baterii 2026 | Nexum Energy</title>
  </head>
  <body>
    <div id="site-intro" class="site-intro" aria-hidden="true">
      <div class="intro-panel intro-panel-left"></div>
      <div class="intro-panel intro-panel-right"></div>
      <div class="intro-inner">
        <div class="intro-logo-frame">
          <img src={assetPath('nexum-energy-logo.png')} width="208" height="208" alt="" class="h-full w-full object-contain p-4" />
        </div>
        <p class="mt-7 text-xs font-bold tracking-[0.28em] text-white/72 uppercase">Nexum Energy</p>
        <div class="intro-line mx-auto mt-4"></div>
      </div>
    </div>
    <noscript><style>.site-intro{display:none!important}</style></noscript>
    <a href="#continut" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-3">Sari la conținut</a>

    <header class="site-header page-shell absolute inset-x-0 top-0 z-30 flex h-28 items-center justify-between border-b border-white/15" aria-label="Navigație principală">
      <a href="#program" class="flex items-center gap-4" aria-label="Nexum Energy, prima secțiune">
        <img src={assetPath('nexum-energy-logo.png')} width="64" height="64" alt="Logo Nexum Energy" class="h-16 w-16 rounded-sm bg-white object-contain p-1.5 shadow-[0_10px_35px_rgba(0,0,0,0.22)]" />
        <span class="hidden text-sm font-bold tracking-[0.18em] text-white uppercase sm:block">Nexum Energy</span>
      </a>
      <nav class="hidden items-center gap-8 text-sm font-semibold text-white/70 lg:flex" aria-label="Secțiuni pagină">
        <a class="transition hover:text-white" href="#program">Programul</a>
        <a class="transition hover:text-white" href="#bateria-360">Bateria</a>
        <a class="transition hover:text-white" href="#eligibilitate">Eligibilitate</a>
        <a class="transition hover:text-white" href="#documente">Documente</a>
        <a class="transition hover:text-white" href="#intrebari">Întrebări</a>
      </nav>
      <a href="#eligibilitate" class="rounded-sm border border-white/35 bg-white/10 px-5 py-3 text-sm font-bold text-white backdrop-blur-sm transition hover:border-white hover:bg-white hover:text-forest">Vezi dacă te încadrezi</a>
    </header>

    <main id="continut">
      <section id="program" class="hero-premium relative isolate min-h-[900px] overflow-hidden text-white">
        <div class="hero-product-scene absolute inset-0 -z-20 overflow-hidden">
          <div class="hero-product-aura" aria-hidden="true"></div>
          <img src={batteryViews[2]} alt="Baterie modulară albă pentru stocarea energiei fotovoltaice" class="hero-product-image" draggable="false" fetchpriority="high" />
        </div>
        <div class="hero-overlay absolute inset-0 -z-10"></div>
        <div class="page-shell relative z-10 flex min-h-[900px] flex-col justify-center pt-36 pb-16">
          <div class="max-w-[49rem]">
            <span class="eyebrow eyebrow-light">Program AFM · fonduri nerambursabile</span>
            <h1 class="font-display mt-9 text-[clamp(3.15rem,6vw,5.9rem)] leading-[0.91] font-semibold tracking-[-0.06em] uppercase">Casa Verde —<br /><span class="text-[#d4dcc0]">Baterii 2026.</span></h1>
            <p class="mt-9 max-w-2xl text-lg leading-8 text-white/72">Prin programul AFM poți obține până la 15.000 lei nerambursabili pentru achiziția și montarea unei baterii de stocare. Finanțarea poate acoperi maximum 75% din costul eligibil.</p>
            <div class="mt-10 flex flex-col gap-3 sm:flex-row">
              <a href="#eligibilitate" class="inline-flex min-h-14 items-center justify-center rounded-sm bg-[#d0d8b8] px-7 text-base font-bold text-[#10231c] transition hover:bg-white">Verifică dacă te încadrezi <span aria-hidden="true" class="ml-3">→</span></a>
              <a href="#documente" class="inline-flex min-h-14 items-center justify-center rounded-sm border border-white/30 bg-black/10 px-7 text-base font-semibold text-white backdrop-blur-sm transition hover:border-white/70 hover:bg-white/10">Detalii program</a>
            </div>
          </div>
          <ol class="funding-flow mt-16" aria-label="Traseul de la finanțare la economie">
            {fundingFlow.map(([number, title, description]) => (
              <li class="funding-flow-step">
                <span class="funding-flow-number">{number}</span>
                <strong>{title}</strong>
                <span>{description}</span>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section aria-label="Avantajele verificării" class="border-y border-[#dbe4dc] bg-white/65">
        <div class="page-shell grid text-sm text-[#53665d] sm:grid-cols-3">
          <p class="flex items-center gap-4 border-b border-[#dbe4dc] py-6 sm:border-r sm:border-b-0 sm:px-6 sm:first:pl-0"><span class="text-xs font-bold tracking-[0.16em] text-moss">01</span> Finanțare nerambursabilă</p>
          <p class="flex items-center gap-4 border-b border-[#dbe4dc] py-6 sm:border-r sm:border-b-0 sm:px-6"><span class="text-xs font-bold tracking-[0.16em] text-moss">02</span> Baterie și montaj eligibile</p>
          <p class="flex items-center gap-4 py-6 sm:pl-6"><span class="text-xs font-bold tracking-[0.16em] text-moss">03</span> Verificare și ofertă personalizată</p>
        </div>
      </section>

      <section id="bateria-360" class="battery-showcase section-pad overflow-hidden text-white">
        <div class="page-shell grid gap-12 lg:grid-cols-[0.72fr_1.28fr] lg:items-center">
          <div class="max-w-lg">
            <span class="eyebrow eyebrow-light">Prezentare interactivă</span>
            <p class="mt-9 text-xs font-bold tracking-[0.2em] text-[#cbd5b1] uppercase">ESA3-10K · sistem modular</p>
            <h2 class="mt-5 text-4xl font-semibold tracking-[-0.055em] sm:text-6xl">Rotește bateria. Privește produsul.</h2>
            <p class="mt-7 text-lg leading-8 text-white/65">Ține apăsat pe baterie și trage stânga–dreapta. Poți folosi și comenzile de sub produs pentru a schimba unghiul.</p>
            <div class="mt-10 border-t border-white/14 pt-6 text-sm leading-7 text-white/55">
              <p><span class="mr-3 font-bold text-[#cbd5b1]">01</span> Apasă și ține cursorul pe produs</p>
              <p><span class="mr-3 font-bold text-[#cbd5b1]">02</span> Trage spre stânga sau spre dreapta</p>
            </div>
          </div>

          <div id="battery-360-viewer" class="battery-viewer-stage" data-battery-frames={JSON.stringify(batteryViews)} tabindex="0" role="group" aria-label="Vizualizare interactivă a bateriei, vedere din stânga">
            <div class="battery-viewer-aura" aria-hidden="true"></div>
            <img id="battery-360-image" src={batteryViews[2]} alt="Baterie modulară albă pentru stocarea energiei fotovoltaice, vedere din stânga" class="battery-viewer-product" draggable="false" loading="lazy" />
            <p class="battery-viewer-drag"><span aria-hidden="true">↔</span> Ține apăsat și trage</p>
            <div class="battery-viewer-toolbar">
              <button id="battery-view-previous" type="button" aria-label="Unghiul anterior al bateriei">←</button>
              <div><strong>360°</strong><span id="battery-view-label" aria-live="polite">Vedere din stânga</span></div>
              <button id="battery-view-next" type="button" aria-label="Unghiul următor al bateriei">→</button>
            </div>
          </div>
        </div>
      </section>

      <section class="section-pad page-shell">
        <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
          <div><span class="eyebrow">Ce finanțează programul</span><h2 class="mt-5 text-4xl font-extrabold tracking-[-0.05em] text-ink sm:text-5xl">Stocare nouă pentru energia produsă acasă.</h2></div>
          <p class="max-w-2xl text-lg leading-8 text-[#5b6c64] lg:justify-self-end">Sunt eligibile achiziția unui sistem de minimum 12 kWh, montajul, punerea în funcțiune și TVA-ul aferent. Cheltuielile trebuie realizate după aprobarea finanțării de către AFM.</p>
        </div>
        <div class="mt-12 grid gap-4 md:grid-cols-3">
          <article class="rounded-lg border border-[#d8e2da] bg-white p-7"><span class="text-xs font-bold tracking-[0.16em] text-moss uppercase">01 · Achiziție</span><h3 class="mt-5 text-2xl font-bold tracking-[-0.03em]">Sistem de stocare nou</h3><p class="mt-3 leading-7 text-[#65756d]">Capacitate de minimum 12 kWh, tehnologie fără plumb și compatibilitate cu instalația existentă.</p></article>
          <article class="rounded-lg border border-[#d8e2da] bg-white p-7"><span class="text-xs font-bold tracking-[0.16em] text-moss uppercase">02 · Instalare</span><h3 class="mt-5 text-2xl font-bold tracking-[-0.03em]">Montaj și punere în funcțiune</h3><p class="mt-3 leading-7 text-[#65756d]">Lucrările aferente sistemului de stocare sunt incluse între cheltuielile eligibile.</p></article>
          <article class="rounded-lg border border-[#d8e2da] bg-forest p-7 text-white"><span class="text-xs font-bold tracking-[0.16em] text-lime uppercase">03 · Compatibilitate</span><h3 class="mt-5 text-2xl font-bold tracking-[-0.03em]">Invertor hibrid, dacă este necesar</h3><p class="mt-3 leading-7 text-white/65">Poate fi instalat până la punerea în funcțiune a bateriei. Costul lui nu este enumerat ca cheltuială eligibilă.</p></article>
        </div>
      </section>

      <section id="eligibilitate" class="section-pad bg-mist">
        <div class="page-shell">
          <div class="mx-auto max-w-3xl text-center"><span class="eyebrow">Chestionar de eligibilitate</span><h2 class="mt-5 text-4xl font-extrabold tracking-[-0.055em] text-ink sm:text-6xl">Poți obține finanțarea?</h2><p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-[#5d6e66]">Completează cele două etape scurte. Verificăm dacă te încadrezi pentru fondurile nerambursabile și revenim cu răspunsul și oferta pentru baterie.</p></div>
          <div class="mx-auto mt-12 max-w-5xl overflow-hidden rounded-lg border border-[#cbd6cd] bg-white shadow-[0_24px_70px_rgba(16,35,28,0.08)]">
            <div class="border-b border-[#e0e7e1] px-5 py-6 sm:px-9">
              <div class="grid grid-cols-2 gap-4" aria-label="Progres chestionar">
                {['Eligibilitate', 'Date de contact'].map((label, index) => (
                  <div class="progress-item flex items-center gap-2" data-progress-index={index} aria-current={index === 0 ? 'step' : undefined}><span class:list={['grid h-8 w-8 shrink-0 place-items-center rounded-sm text-xs font-bold', index === 0 ? 'bg-forest text-white' : 'bg-[#eaf0eb] text-[#718078]']}>{index + 1}</span><span class="hidden text-xs font-bold tracking-[0.12em] text-[#5e6e66] uppercase sm:block">{label}</span></div>
                ))}
              </div>
              <div class="mt-5 h-1 overflow-hidden rounded-sm bg-[#e8eee9]" aria-hidden="true"><div id="progress-bar" class="h-full w-1/2 bg-moss transition-[width] duration-300"></div></div>
            </div>

            <form id="eligibility-form" data-endpoint={contactEndpoint} data-email={contactEmail} novalidate class="px-5 py-8 sm:px-9 sm:py-10">
              <div id="step-alert" class="mb-6 hidden rounded-sm border border-[#e4b8a9] bg-[#fff4ef] px-4 py-3 text-sm font-semibold text-[#7a3528]" role="alert">Alege un răspuns pentru fiecare întrebare înainte de a continua.</div>
              <fieldset class="eligibility-step" data-step="0">
                <legend class="text-3xl font-extrabold tracking-[-0.04em] text-ink">Verifică accesul la fondurile nerambursabile</legend><p class="mt-3 max-w-2xl leading-7 text-[#65756d]">Răspunde la cinci întrebări esențiale din ghid. Dacă nu știi un răspuns, poți selecta „Nu sunt sigur”.</p>
                <div class="mt-9 space-y-7">
                  {eligibilityQuestions.map((question) => (
                    <div class="question-group">
                      <p class="text-base font-extrabold text-ink" id={`${question.name}-label`}>{question.title}</p>
                      <div class="mt-3 grid gap-2 sm:grid-cols-3" role="radiogroup" aria-labelledby={`${question.name}-label`}>
                        {question.options.map(([value, label], optionIndex) => <label class="option-card"><input type="radio" name={question.name} value={value} required={optionIndex === 0} /><span class="text-sm font-bold leading-5">{label}</span></label>)}
                      </div>
                    </div>
                  ))}
                </div>
                <div class="mt-10 border-t border-[#e2e8e3] pt-8">
                  <p class="text-xs font-bold tracking-[0.14em] text-moss uppercase">Datele sistemului existent</p>
                  <div class="mt-5 grid gap-6 sm:grid-cols-2">
                    <label class="block"><span class="text-sm font-bold text-ink">Puterea sistemului fotovoltaic</span><span class="relative mt-2 block"><input class="field-input pr-16" type="number" min="0" step="0.1" name="pvPower" inputmode="decimal" placeholder="ex. 6" /><span class="pointer-events-none absolute top-1/2 right-4 -translate-y-1/2 text-sm font-bold text-[#74847b]">kW</span></span></label>
                    <label class="block"><span class="text-sm font-bold text-ink">Ce invertor ai?</span><input class="field-input mt-2" type="text" name="inverter" placeholder="Marcă/model sau «Nu știu»" /></label>
                  </div>
                </div>
              </fieldset>

              <fieldset class="eligibility-step" data-step="1" hidden>
                <legend class="text-3xl font-extrabold tracking-[-0.04em] text-ink">Date pentru verificare</legend><p class="mt-3 max-w-2xl leading-7 text-[#65756d]">Revenim personal cu verificarea eligibilității și o ofertă. Nu solicităm CNP sau documente în această etapă.</p>
                <div class="mt-9 grid gap-6 sm:grid-cols-2">
                  <label class="block sm:col-span-2"><span class="text-sm font-extrabold text-ink">Nume și prenume <span aria-hidden="true" class="text-moss">*</span></span><input class="field-input mt-2" type="text" name="name" autocomplete="name" placeholder="Cum te numești?" required /></label>
                  <label class="block"><span class="text-sm font-extrabold text-ink">Telefon <span aria-hidden="true" class="text-moss">*</span></span><input class="field-input mt-2" type="tel" name="phone" autocomplete="tel" inputmode="tel" placeholder="07xx xxx xxx" required /></label>
                  <label class="block"><span class="text-sm font-extrabold text-ink">E-mail</span><input class="field-input mt-2" type="email" name="email" autocomplete="email" placeholder="nume@exemplu.ro" /></label>
                  <label class="block sm:col-span-2"><span class="text-sm font-extrabold text-ink">Județ și localitate <span aria-hidden="true" class="text-moss">*</span></span><input class="field-input mt-2" type="text" name="location" autocomplete="address-level2" placeholder="ex. Giurgiu, Bolintin-Vale" required /></label>
                </div>
                <label class="mt-7 flex cursor-pointer items-start gap-3 text-sm leading-6 text-[#5f7067]"><input class="mt-1 h-5 w-5 shrink-0 accent-[#2f795e]" type="checkbox" name="consent" required /><span>Sunt de acord ca Nexum Energy să folosească datele introduse pentru verificarea eligibilității și pentru a-mi transmite oferta. <span aria-hidden="true" class="text-moss">*</span></span></label>
                <div id="form-status" class="mt-5 hidden rounded-sm border px-4 py-3 text-sm font-semibold" role="status" aria-live="polite"></div>
              </fieldset>
              <div class="mt-10 flex flex-col-reverse gap-3 border-t border-[#e5ebe6] pt-7 sm:flex-row sm:justify-between">
                <button id="previous-step" type="button" class="hidden min-h-13 rounded-md border border-[#ccd8cf] px-6 font-bold text-forest transition hover:border-moss">Înapoi</button>
                <button id="next-step" type="button" class="min-h-13 rounded-md bg-forest px-7 font-bold text-white transition hover:bg-moss sm:ml-auto">Continuă <span aria-hidden="true">→</span></button>
                <button id="submit-eligibility" type="submit" class="hidden min-h-13 rounded-md bg-lime px-7 font-bold text-forest transition hover:bg-[#d5dcc0] disabled:cursor-wait disabled:opacity-70 sm:ml-auto">Trimite pentru verificare <span aria-hidden="true">→</span></button>
              </div>
              <p class="mt-4 text-xs leading-5 text-[#7b8982]">Câmpurile marcate cu * sunt obligatorii. Eligibilitatea finală este stabilită de AFM după verificarea documentelor.</p>
            </form>
          </div>
        </div>
      </section>

      <section id="documente" class="section-pad page-shell">
        <div class="grid gap-12 lg:grid-cols-[0.74fr_1.26fr]">
          <div class="lg:sticky lg:top-8 lg:self-start"><span class="eyebrow">Dosarul de înscriere</span><h2 class="mt-5 text-4xl font-extrabold tracking-[-0.05em] text-ink sm:text-5xl">Pregătește documentele înainte de deschiderea sesiunii.</h2><p class="mt-5 leading-7 text-[#65756d]">Aplicația nu permite modificarea sau înlocuirea documentelor după finalizarea înscrierii. Verifică numele, adresa și valabilitatea fiecărui act.</p><a href={assetPath('ghid-finantare-stocare.docx')} download class="mt-7 inline-flex min-h-13 items-center rounded-sm border border-[#aebeb2] px-6 font-bold text-forest transition hover:border-moss hover:bg-mist">Descarcă ghidul folosit <span class="ml-3" aria-hidden="true">↓</span></a></div>
          <ol class="overflow-hidden rounded-lg border border-[#d7e1d9] bg-white">
            {documents.map(([title, description], index) => <li class="grid gap-3 border-b border-[#e3e9e4] p-5 last:border-0 sm:grid-cols-[3rem_1fr] sm:p-6"><span class="grid h-10 w-10 place-items-center rounded-sm border border-[#d8e1da] bg-mist text-sm font-bold text-moss">{String(index + 1).padStart(2, '0')}</span><div><h3 class="font-bold text-ink">{title}</h3><p class="mt-1 text-sm leading-6 text-[#687870]">{description}</p></div></li>)}
          </ol>
        </div>
      </section>

      <section class="bg-forest py-20 text-white">
        <div class="page-shell grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
          <div><span class="inline-flex rounded-sm border border-white/15 bg-white/5 px-4 py-2 text-xs font-bold tracking-[0.16em] text-lime uppercase">De la finanțare la instalare</span><h2 class="mt-6 max-w-3xl text-4xl font-extrabold tracking-[-0.05em] sm:text-6xl">Transformăm finanțarea într-un sistem de stocare potrivit casei tale.</h2></div>
          <div class="grid gap-4 sm:grid-cols-3 lg:grid-cols-1">{[['01', 'Verificăm instalația și compatibilitatea'], ['02', 'Dimensionăm bateria pentru consum'], ['03', 'Pregătim oferta și pașii de implementare']].map(([number, title]) => <div class="flex items-center gap-5 border-b border-white/13 pb-4 last:border-0"><span class="text-sm font-extrabold text-lime">{number}</span><p class="font-bold text-white/85">{title}</p></div>)}</div>
        </div>
      </section>

      <section id="intrebari" class="section-pad border-t border-[#dde5de] bg-white/55">
        <div class="page-shell grid gap-12 lg:grid-cols-[0.7fr_1.3fr]">
          <div><span class="eyebrow">Întrebări frecvente</span><h2 class="mt-5 text-4xl font-extrabold tracking-[-0.05em] text-ink sm:text-5xl">Clar, înainte de a începe.</h2></div>
          <div class="space-y-3">{faqs.map(([question, answer]) => <details class="group rounded-lg border border-[#d8e1da] bg-white p-5 sm:p-6"><summary class="flex cursor-pointer list-none items-center justify-between gap-5 font-bold text-ink"><span>{question}</span><span class="faq-plus grid h-8 w-8 shrink-0 place-items-center rounded-sm bg-mist text-xl font-normal text-moss" aria-hidden="true">+</span></summary><p class="mt-4 max-w-3xl pr-10 text-sm leading-7 text-[#64756c]">{answer}</p></details>)}</div>
        </div>
      </section>
    </main>

    <footer class="bg-[#0e2b22] py-10 text-white">
      <div class="page-shell flex flex-col gap-8 border-b border-white/12 pb-9 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-center gap-3"><img src={assetPath('nexum-energy-logo.png')} width="52" height="52" alt="Logo Nexum Energy" class="h-12 w-12 rounded-sm bg-white object-contain p-1" /><div><p class="text-sm font-bold tracking-[0.16em] uppercase">Nexum Energy</p><p class="mt-1 text-xs text-white/55">Energie regenerabilă · stocare · autonomie</p></div></div>
        <div class="flex flex-wrap gap-x-6 gap-y-3 text-sm font-bold text-white/75"><a href="#eligibilitate" class="hover:text-lime">Verifică eligibilitatea</a><a href="#documente" class="hover:text-lime">Documente</a><a href="#eligibilitate" class="hover:text-lime">Solicită oferta</a></div>
      </div>
      <div class="page-shell flex flex-col gap-4 pt-7 text-xs leading-5 text-white/48 sm:flex-row sm:justify-between"><p>© {new Date().getFullYear()} Nexum Energy. Toate drepturile rezervate.</p><p class="max-w-2xl">Informațiile și verificarea sunt orientative, pe baza ghidului furnizat. Condițiile finale, calendarul sesiunii și decizia de finanțare aparțin Administrației Fondului pentru Mediu.</p></div>
    </footer>

    <script is:inline>
      (() => {
        const intro = document.getElementById('site-intro');
        if (intro) {
          const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.setTimeout(() => {
            intro.classList.add('is-leaving');
            window.setTimeout(() => intro.remove(), reducedMotion ? 50 : 1050);
          }, reducedMotion ? 80 : 1500);
        }

        const batteryStage = document.getElementById('battery-360-viewer');
        const batteryImage = document.getElementById('battery-360-image');
        const batteryLabel = document.getElementById('battery-view-label');
        const batteryPrevious = document.getElementById('battery-view-previous');
        const batteryNext = document.getElementById('battery-view-next');
        if (batteryStage && batteryImage) {
          const frames = JSON.parse(batteryStage.dataset.batteryFrames || '[]');
          const frameLabels = ['vedere din dreapta', 'vedere frontală', 'vedere din stânga'];
          frames.forEach((src) => { const preload = new Image(); preload.src = src; });
          let frameIndex = 2;
          let dragStartX = 0;
          let dragStartFrame = frameIndex;
          let isDragging = false;
          let hasInteracted = false;

          const setBatteryFrame = (nextIndex) => {
            const boundedIndex = Math.min(frames.length - 1, Math.max(0, nextIndex));
            if (boundedIndex === frameIndex || !frames[boundedIndex]) return;
            frameIndex = boundedIndex;
            batteryImage.src = frames[frameIndex];
            batteryImage.alt = `Baterie modulară albă pentru stocarea energiei fotovoltaice, ${frameLabels[frameIndex]}`;
            batteryImage.animate(
              [{ opacity: 0.48, transform: 'translate(-50%, -50%) scale(0.975)' }, { opacity: 1, transform: 'translate(-50%, -50%) scale(1)' }],
              { duration: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 1 : 180, easing: 'ease-out' },
            );
            batteryStage.setAttribute('aria-label', `Vizualizare interactivă a bateriei, ${frameLabels[frameIndex]}`);
            if (batteryLabel) batteryLabel.textContent = frameLabels[frameIndex].replace('vedere', 'Vedere');
          };

          batteryStage.addEventListener('pointerdown', (event) => {
            if (event.pointerType === 'mouse' && event.button !== 0) return;
            if (event.target instanceof Element && event.target.closest('button')) return;
            hasInteracted = true;
            isDragging = true;
            dragStartX = event.clientX;
            dragStartFrame = frameIndex;
            batteryStage.classList.add('is-dragging');
            batteryStage.setPointerCapture?.(event.pointerId);
            event.preventDefault();
          });

          batteryStage.addEventListener('pointermove', (event) => {
            if (!isDragging) return;
            const step = window.innerWidth < 768 ? 48 : 76;
            const movedFrames = Math.round((event.clientX - dragStartX) / step);
            setBatteryFrame(dragStartFrame - movedFrames);
          });

          const stopBatteryDrag = (event) => {
            if (!isDragging) return;
            isDragging = false;
            batteryStage.classList.remove('is-dragging');
            batteryStage.releasePointerCapture?.(event.pointerId);
          };
          batteryStage.addEventListener('pointerup', stopBatteryDrag);
          batteryStage.addEventListener('pointercancel', stopBatteryDrag);
          batteryPrevious?.addEventListener('click', () => { hasInteracted = true; setBatteryFrame(frameIndex === 0 ? frames.length - 1 : frameIndex - 1); });
          batteryNext?.addEventListener('click', () => { hasInteracted = true; setBatteryFrame(frameIndex === frames.length - 1 ? 0 : frameIndex + 1); });
          batteryStage.addEventListener('keydown', (event) => {
            if (event.key === 'ArrowLeft') { event.preventDefault(); hasInteracted = true; batteryPrevious?.click(); }
            if (event.key === 'ArrowRight') { event.preventDefault(); hasInteracted = true; batteryNext?.click(); }
          });

          if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            const startBatteryDemo = () => {
              window.setTimeout(() => { if (!hasInteracted) setBatteryFrame(1); }, 350);
              window.setTimeout(() => { if (!hasInteracted) setBatteryFrame(0); }, 1050);
              window.setTimeout(() => { if (!hasInteracted) setBatteryFrame(2); }, 1850);
            };
            const observer = new IntersectionObserver((entries) => {
              if (entries.some((entry) => entry.isIntersecting)) {
                observer.disconnect();
                startBatteryDemo();
              }
            }, { threshold: 0.35 });
            observer.observe(batteryStage);
          }
        }

        const eligibilityForm = document.getElementById('eligibility-form');
        const steps = Array.from(document.querySelectorAll('.eligibility-step'));
        const nextButton = document.getElementById('next-step');
        const previousButton = document.getElementById('previous-step');
        const submitButton = document.getElementById('submit-eligibility');
        const stepAlert = document.getElementById('step-alert');
        const progressBar = document.getElementById('progress-bar');
        const progressItems = Array.from(document.querySelectorAll('.progress-item'));
        const formStatus = document.getElementById('form-status');
        let currentStep = 0;
        const clamp = (value, min, max) => Math.min(max, Math.max(min, value));

        const setStep = (index, focusHeading = true) => {
          currentStep = clamp(index, 0, steps.length - 1);
          steps.forEach((step, stepIndex) => { step.hidden = stepIndex !== currentStep; });
          previousButton.classList.toggle('hidden', currentStep === 0);
          nextButton.classList.toggle('hidden', currentStep === steps.length - 1);
          submitButton.classList.toggle('hidden', currentStep !== steps.length - 1);
          stepAlert.classList.add('hidden');
          progressBar.style.width = `${((currentStep + 1) / steps.length) * 100}%`;
          progressItems.forEach((item, itemIndex) => {
            const dot = item.querySelector('span');
            const isActive = itemIndex === currentStep;
            const isDone = itemIndex < currentStep;
            item.toggleAttribute('aria-current', isActive);
            dot.className = `grid h-8 w-8 shrink-0 place-items-center rounded-sm text-xs font-bold ${isActive || isDone ? 'bg-forest text-white' : 'bg-[#eaf0eb] text-[#718078]'}`;
            dot.textContent = isDone ? '✓' : String(itemIndex + 1);
          });
          if (focusHeading) {
            const legend = steps[currentStep].querySelector('legend');
            legend?.setAttribute('tabindex', '-1');
            legend?.focus({ preventScroll: true });
            document.getElementById('eligibilitate')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        };

        const validateCurrentStep = () => {
          const controls = Array.from(steps[currentStep].querySelectorAll('input, select, textarea'));
          for (const control of controls) {
            if (!control.checkValidity()) {
              stepAlert.textContent = currentStep === 0 ? 'Alege un răspuns pentru fiecare întrebare înainte de a continua.' : 'Completează câmpurile obligatorii înainte de trimitere.';
              stepAlert.classList.remove('hidden'); control.reportValidity(); control.focus(); return false;
            }
          }
          stepAlert.classList.add('hidden'); return true;
        };

        nextButton?.addEventListener('click', () => { if (validateCurrentStep()) setStep(currentStep + 1); });
        previousButton?.addEventListener('click', () => setStep(currentStep - 1));

        eligibilityForm?.addEventListener('submit', async (event) => {
          event.preventDefault(); if (!validateCurrentStep()) return;
          const formData = new FormData(eligibilityForm);
          const endpoint = eligibilityForm.dataset.endpoint;
          const email = eligibilityForm.dataset.email;
          const showStatus = (message, tone) => {
            formStatus.textContent = message;
            formStatus.className = `mt-5 rounded-sm border px-4 py-3 text-sm font-semibold ${tone === 'success' ? 'border-[#a7c99b] bg-[#f2f8ef] text-[#25523d]' : 'border-[#e3b1a1] bg-[#fff3ef] text-[#7b382b]'}`;
          };
          if (endpoint) {
            submitButton.disabled = true; submitButton.textContent = 'Se trimite…';
            try {
              const response = await fetch(endpoint, { method: 'POST', body: formData, headers: { Accept: 'application/json' } });
              if (!response.ok) throw new Error('Request failed');
              eligibilityForm.reset(); showStatus('Solicitarea a fost trimisă. Verificăm eligibilitatea și revenim cu răspunsul și oferta.', 'success');
            } catch { showStatus('Solicitarea nu a putut fi trimisă. Încearcă din nou sau contactează-ne direct.', 'error'); }
            finally { submitButton.disabled = false; submitButton.innerHTML = 'Trimite pentru verificare <span aria-hidden="true">→</span>'; }
            return;
          }
          const answers = {
            yes: 'Da', no: 'Nu', unknown: 'Nu sunt sigur', none: 'Nu',
            separate: 'Da, cu contor separat', unseparated: 'Da, fără contor separat',
          };
          const answer = (name) => answers[String(formData.get(name))] || String(formData.get(name) || 'nespecificat');
          const lines = [
            'Solicitare verificare eligibilitate', '',
            `Nume: ${formData.get('name')}`,
            `Telefon: ${formData.get('phone')}`,
            `E-mail: ${formData.get('email') || 'nespecificat'}`,
            `Localitate: ${formData.get('location')}`,
            `Putere fotovoltaică: ${formData.get('pvPower') || 'nespecificată'} kW`,
            `Invertor: ${formData.get('inverter') || 'nespecificat'}`, '',
            `Persoană fizică/prosumator/contract pe nume: ${answer('prosumator')}`,
            `Fără restanțe fiscale: ${answer('debts')}`,
            `Locuință în România și sistem racordat: ${answer('grid')}`,
            `Baterie deja instalată: ${answer('existingStorage')}`,
            `Activitate economică la adresă: ${answer('activities')}`,
          ];
          window.location.href = `mailto:${email || ''}?subject=${encodeURIComponent('Verificare eligibilitate – sistem de stocare')}&body=${encodeURIComponent(lines.join('\n'))}`;
          showStatus(email ? 'Am deschis aplicația de e-mail cu solicitarea completată.' : 'Solicitarea este pregătită în aplicația de e-mail. Adaugă adresa Nexum Energy înainte de trimitere.', 'success');
        });
        setStep(0, false);
      })();
    </script>
  </body>
</html>
